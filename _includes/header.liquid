<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search (grep the site)" onclick="openSearchModal()">
                <span class="nav-link grep-trigger"><i class="fa-solid fa-magnifying-glass"></i>&nbsp;grep&nbsp;<kbd>^K</kbd></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}

  <!-- Mobile bottom tab bar (phones only) -->
  <nav class="mobile-tabbar" aria-label="Primary">
    <a class="mtab {% if page.permalink == '/' %}active{% endif %}" href="{{ '/' | relative_url }}">
      <i class="fa-solid fa-house"></i><span>Home</span>
    </a>
    <a class="mtab {% if page.url contains '/projects' %}active{% endif %}" href="{{ '/projects/' | relative_url }}">
      <i class="fa-solid fa-diagram-project"></i><span>Projects</span>
    </a>
    <a class="mtab {% if page.url contains '/publications' %}active{% endif %}" href="{{ '/publications/' | relative_url }}">
      <i class="fa-solid fa-book"></i><span>Papers</span>
    </a>
    <a class="mtab {% if page.url contains '/cv' %}active{% endif %}" href="{{ '/cv/' | relative_url }}">
      <i class="fa-solid fa-id-card"></i><span>CV</span>
    </a>
    <button class="mtab" type="button" id="more-toggle" aria-controls="mobile-sheet" aria-expanded="false">
      <i class="fa-solid fa-ellipsis"></i><span>More</span>
    </button>
  </nav>

  <div class="mobile-sheet-backdrop" id="mobile-sheet-backdrop"></div>
  <div class="mobile-sheet" id="mobile-sheet" role="dialog" aria-modal="true" aria-label="More navigation">
    <div class="msheet-grabber"></div>
    <nav class="msheet-links" aria-label="All pages">
      <a class="msheet-link {% if page.permalink == '/' %}active{% endif %}" href="{{ '/' | relative_url }}">about</a>
      {% assign sorted_pages = site.pages | sort: 'nav_order' %}
      {% for p in sorted_pages %}
        {% if p.nav and p.autogen == null and p.permalink != '/' %}
          <a class="msheet-link {% if page.url == p.url %}active{% endif %}" href="{{ p.url | relative_url }}">{{ p.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    <div class="msheet-actions">
      {% if site.search_enabled %}
        <button type="button" class="msheet-action" onclick="closeMobileSheet(); openSearchModal();">
          <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
      {% endif %}
      {% if site.enable_darkmode %}
        <button type="button" class="msheet-action" onclick="document.getElementById('light-toggle').click();">
          <i class="fa-solid fa-circle-half-stroke"></i> Theme
        </button>
      {% endif %}
    </div>
  </div>

  <script>
    (function () {
      var moreBtn = document.getElementById("more-toggle");
      var sheet = document.getElementById("mobile-sheet");
      var backdrop = document.getElementById("mobile-sheet-backdrop");
      if (!moreBtn || !sheet || !backdrop) return;
      function setOpen(o) {
        sheet.classList.toggle("open", o);
        backdrop.classList.toggle("open", o);
        moreBtn.setAttribute("aria-expanded", o ? "true" : "false");
      }
      window.closeMobileSheet = function () { setOpen(false); };
      moreBtn.addEventListener("click", function () { setOpen(!sheet.classList.contains("open")); });
      backdrop.addEventListener("click", function () { setOpen(false); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape") setOpen(false); });
    })();
  </script>
</header>
