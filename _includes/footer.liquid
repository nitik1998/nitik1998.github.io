{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  <br />
  <span style="font-size: 0.8rem; opacity: 0.75;">Terminal-style design inspired by <a href="https://lbugnon.github.io" target="_blank" rel="noopener">Leandro A. Bugnon</a>.</span>
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% comment %} Visitor map (ClustrMaps) — shows where visitors came from. Set clustrmaps_id in _config.yml. {% endcomment %}
{% capture visitor_map %}
  {% if site.clustrmaps_id and site.clustrmaps_id != "" %}
    <div class="visitor-map text-center mt-2 mb-2">
      <p class="mb-1" style="font-size: 0.7rem; opacity: 0.7;">Visitors</p>
      <script type="text/javascript" id="clustrmaps" src="//cdn.clustrmaps.com/map_v2.js?cl=ffffff&w=240&t=tt&d={{ site.clustrmaps_id }}&co=2d78ad&cmo=3acc3a&cmn=ff5353&ct=808080"></script>
    </div>
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ visitor_map }}
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
