{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  <br />
  <span style="font-size: 0.8rem; opacity: 0.75;">Terminal-style design inspired by <a href="https://lbugnon.github.io" target="_blank" rel="noopener">Leandro A. Bugnon</a>.</span>
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% comment %} Visitor globe (MapMyVisitors) — subtle, footer-only; shows where views come from. {% endcomment %}
{% capture visitor_map %}
  <div class="visitor-globe" aria-hidden="true" title="where visitors are viewing from">
    <script type="text/javascript" id="mmvst_globe" src="//mapmyvisitors.com/globe.js?d=TZElgG1zwa0JR-KlaZGPgGL1gmpsPTclvL8z39D_5tA"></script>
  </div>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ visitor_map }}
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
