---
layout: default
---
<div class="post">
  <section class="banner">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>

    <div class="banner-row">
      <div class="banner-terminal">
        <div class="terminal-window">
          <div class="terminal-bar">
            <span class="t-dot t-red"></span><span class="t-dot t-yellow"></span><span class="t-dot t-green"></span>
            <span class="terminal-title">nitik@jhu: ~</span>
          </div>
          <div class="terminal-body">
            <p><span class="t-prompt">nitik@jhu:~$</span> whoami</p>
            <p class="t-out">Nitik Jain — MSE Robotics @ Johns Hopkins · AI × Robotics</p>
            <p><span class="t-prompt">nitik@jhu:~$</span> cat research_focus.txt</p>
            <p class="t-out">robot learning · vision-language-action models · perception · generative &amp; medical AI</p>
            <p><span class="t-prompt">nitik@jhu:~$</span> cat short_bio.txt</p>
            <p class="t-out">Robotics researcher bridging perception, robot learning, and generative AI — from medical imaging to vision-language-action models.</p>
            <p class="t-line"><span class="t-prompt">nitik@jhu:~$</span> <span class="t-cursor"></span></p>
          </div>
        </div>
      </div>

      {% if page.profile %}
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        <div class="banner-side">
          {%
            include figure.liquid loading="eager" path=profile_image_path class="z-depth-1 profile-img" sizes="220px" alt=page.profile.image
            cache_bust=true
          %}
          {% if page.social %}
            <div class="contact-icons profile-social">
              <a href="mailto:{{ site.data.socials.email }}" title="Email"><i class="fa-solid fa-envelope"></i></a>
              <a href="https://github.com/{{ site.data.socials.github }}" title="GitHub" target="_blank" rel="noopener"><i class="fa-brands fa-github"></i></a>
              <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin }}" title="LinkedIn" target="_blank" rel="noopener"><i class="fa-brands fa-linkedin"></i></a>
              <a href="https://x.com/{{ site.data.socials.x_username }}" title="X (Twitter)" target="_blank" rel="noopener"><i class="fa-brands fa-x-twitter"></i></a>
              <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" title="Google Scholar" target="_blank" rel="noopener"><i class="ai ai-google-scholar"></i></a>
              <a href="{{ site.data.socials.cv_full | relative_url }}" title="Curriculum Vitae (PDF)" target="_blank" rel="noopener"><i class="fa-solid fa-file-lines"></i></a>
              <a href="{{ site.data.socials.cv_pdf | relative_url }}" title="Résumé (PDF)" target="_blank" rel="noopener"><i class="fa-solid fa-file-pdf"></i></a>
            </div>
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </section>

  <article>
    <!-- Bio -->
    <h2 class="terminal-h section-head">
      <span style="color: inherit">$ cat ~/bio.txt</span>
    </h2>
    <div class="clearfix">{{ content }}</div>

    <!-- Affiliations -->
    {% include affiliations.liquid %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <hr class="section-sep" />
      <h2 class="terminal-h">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">$ tail ~/news.log</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="terminal-h">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">$ cat ~/publications.bib</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Contact note -->
    {% if page.social %}
      <div class="social">
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
